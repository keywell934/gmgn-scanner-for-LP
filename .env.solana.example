# ── Solana (Meridian DLMM pre-filter) ──────────
# GMGN CLI chain = sol, scanner chain = solana (auto-alias)
CHAIN=solana
INTERVAL=5m

# Volume range in 5m window (USD)
MIN_VOLUME_USD=200000
MAX_VOLUME_USD=1000000

# Holder & smart money
MIN_HOLDERS=750
MIN_SMART_DEGEN=1
REJECT_WASH_TRADING=true

# ── Cookin.fun enrichment ──────────────────
# Free API key from cookin.fun/account/api-keys
COOKIN_API_KEY=
COOKIN_MIN_SCORE=3
COOKIN_MAX_DUMP_CONDITIONS=15
COOKIN_MAX_BUNDLE_PCT=60
COOKIN_REQUIRE_DEX_PAID=false

# Candidates output
MAX_CANDIDATES=5
OUTPUT_FORMAT=json

# GMGN CLI path (server)
GMGN_CLI_PATH=/home/ubuntu/.local/bin/gmgn-cli
GMGN_API_KEY=gmgn_solbscbaseethmonadtron
