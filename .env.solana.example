# ── Solana (Meridian DLMM pre-filter) ──────────
# GMGN CLI chain = sol, scanner chain = solana (auto-alias)
CHAIN=solana
INTERVAL=1h

# Volume range in 1h window (USD) — Solana 5m too small for $200K
MIN_VOLUME_USD=200000
MAX_VOLUME_USD=1000000

# Holder & smart money
MIN_HOLDERS=750
MIN_SMART_DEGEN=1
REJECT_WASH_TRADING=true

# Candidates output
MAX_CANDIDATES=5
OUTPUT_FORMAT=json

# GMGN CLI path (server)
GMGN_CLI_PATH=/home/ubuntu/.local/bin/gmgn-cli
GMGN_API_KEY=gmgn_solbscbaseethmonadtron
