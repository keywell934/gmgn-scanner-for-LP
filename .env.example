# GMGN API key (demo key works for read-only)
GMGN_API_KEY=gmgn_solbscbaseethmonadtron

# Path to gmgn-cli binary
GMGN_CLI_PATH=/usr/local/bin/gmgn-cli

# Chain to scan (robinhood | ethereum | base | bsc | solana)
CHAIN=robinhood

# ── Filter params ──────────────────────────
# Volume range in 5m window (USD)
MIN_VOLUME_USD=200000
MAX_VOLUME_USD=1000000

# Holder threshold
MIN_HOLDERS=750

# Smart degen threshold
MIN_SMART_DEGEN=1

# Reject wash trading tokens
REJECT_WASH_TRADING=true

# Max candidates to return (top N by volume)
MAX_CANDIDATES=5

# ── Output ──────────────────────────────────
# Output format: json | pretty (human-readable)
OUTPUT_FORMAT=json
